{
  "name": "lxrt",
  "version": "0.7.1",
  "description": "Unified TypeScript library for local AI - LLM, TTS, STT, Embeddings, OCR, and RAG vectorization with Transformers.js",
  "homepage": "https://github.com/kacperpaczos/lxrt#readme",
  "engines": {
    "node": ">=24.13.0"
  },
  "main": "dist/index.js",
  "browser": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lxrt": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/ui/react/index.d.ts",
      "import": "./dist/ui/react/index.js"
    },
    "./vue": {
      "types": "./dist/ui/vue/index.d.ts",
      "import": "./dist/ui/vue/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./workers": {
      "types": "./dist/infra/workers/index.d.ts",
      "import": "./dist/infra/workers/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "test": "npm run test:node:all",
    "test:unit": "jest --config jest.node.config.js --testPathPatterns=tests/node/unit",
    "test:node:unit": "jest --config jest.node.config.js --testPathPatterns=tests/node/unit",
    "test:node:integration": "jest --config jest.node.config.js --testPathPatterns=tests/node/integration --runInBand",
    "test:single": "jest --config jest.node.config.js",
    "test:node:all": "npm run test:node:unit && npm run test:node:integration",
    "test:node:example": "node --experimental-modules test-node-example.mjs",
    "test:all": "npm run test:node:all",
    "test:examples": "node --check examples/*.js && echo '✅ All examples syntax OK'",
    "test:watch": "jest --config jest.unit.config.js --watch",
    "test:coverage": "jest --config jest.coverage.config.js",
    "test:debug": "DEBUG_TESTS=true jest --config jest.node.config.js",
    "test:llm": "jest --config jest.node.config.js --testPathPattern=\"llm\"",
    "test:stt": "jest --config jest.node.config.js --testPathPattern=\"stt\"",
    "test:tts": "jest --config jest.node.config.js --testPathPattern=\"tts\"",
    "test:ocr": "jest --config jest.node.config.js --testPathPattern=\"ocr\"",
    "test:embedding": "jest --config jest.node.config.js --testPathPattern=\"embedding\"",
    "test:adapter": "jest --config jest.node.config.js --testPathPattern=\"adapter\"",
    "test:cache": "jest --config jest.node.config.js --testPathPattern=\"cache\"",
    "test:lifecycle": "jest --config jest.node.config.js --testPathPattern=\"lifecycle\"",
    "test:flow": "jest --config jest.node.config.js --testPathPattern=\"flow\"",
    "test:model": "jest --config jest.node.config.js --testPathPattern=\"model\"",
    "serve:e2e": "node tests/e2e/server.js",
    "serve:browser": "node tests/integration-browser/server.mjs",
    "test:e2e": "playwright test",
    "test:browser": "npm run test:e2e",
    "lint": "eslint 'src/**/*.ts' --ignore-pattern 'src/**/*.test.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --ignore-pattern 'src/**/*.test.ts' --fix",
    "format": "prettier --write 'src/**/*.{ts,js,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json,md}'",
    "prepare": "husky"
  },
  "keywords": [
    "transformers",
    "ai",
    "agents",
    "llm",
    "speech",
    "whisper",
    "tts",
    "stt",
    "local-ai",
    "huggingface",
    "transformers.js",
    "openai-compatible",
    "agent-framework",
    "text-to-speech",
    "speech-to-text",
    "machine-learning",
    "natural-language-processing",
    "browser-ai",
    "web-ai",
    "onnx",
    "voice-profiles",
    "react",
    "vue",
    "typescript",
    "javascript"
  ],
  "author": "Kacper Paczos",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/tesseract.js": "^0.0.2",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "canvas": "^3.2.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node-single-context": "^29.4.0",
    "lint-staged": "^16.2.4",
    "mammoth": "^1.11.0",
    "onnxruntime-common": "^1.21.0",
    "onnxruntime-node": "^1.21.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vue": "^3.5.22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kacperpaczos/lxrt"
  },
  "bugs": {
    "url": "https://github.com/kacperpaczos/lxrt/issues"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/jsdom": "^27.0.0",
    "commander": "^14.0.2",
    "franc": "^6.2.0",
    "franc-min": "^6.2.0",
    "jsdom": "^27.4.0",
    "tesseract.js": "^6.0.1"
  }
}